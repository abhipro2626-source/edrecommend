# Copy to backend/.env and fill in from Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVICE ROLE key — backend only. NEVER put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Password for the optional demo accounts (rahul@edrecommend.demo, priya@edrecommend.demo).
DEMO_PASSWORD=choose-a-demo-password
